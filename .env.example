SESSION_SECRET=replace-me-with-a-random-secret-at-least-32-characters
# All channels accept an existing six-character key; use a longer random key when the network is not fully trusted.
ACCESS_KEY=replace-me-with-a-random-agent-key-at-least-6-characters
# Keep true for HTTPS. Either release channel may set false only on a trusted HTTP network.
SESSION_COOKIE_SECURE=true
# Standalone Hub processes should set this true only behind a trusted reverse proxy.
# Preflight preserves an explicit true/false value in either release channel.
TRUST_PROXY=false
SERVER_PORT=4000
WEB_PORT=38472
# Static Web proxy: explicitly list only the TLS terminator's source IP/CIDRs.
# Empty is fail-closed: client X-Forwarded-Proto is ignored. Space-separated.
DSC_TRUSTED_TLS_PROXY_CIDRS=
# bundled: docker-compose.yml starts local MySQL/Redis.
# external: MYSQL_URL and REDIS_URL point at servers you manage; use
#   docker compose -f docker-compose.external.yml up -d
DSC_DB_MODE=bundled
# Unique per Hub instance when several projects share one Redis server.
# The legacy default keeps the existing "dsc:*" keys.
DSC_INSTANCE_ID=default
# Production requires both URLs unless DSC_ALLOW_LOCAL_FALLBACK=true is
# explicitly set for an intentional local-only deployment.
DSC_ALLOW_LOCAL_FALLBACK=false
# External mode always enables the single-writer advisory lock; bundled mode
# can opt in once the old container is stopped.
DSC_DB_WRITER_LOCK=false

MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=device_state_console
MYSQL_USER=dsc
MYSQL_PASSWORD=change-me-db-password
REDIS_PASSWORD=change-me-redis-password
# Use a URL-safe password or percent-encode reserved URL characters.
REDIS_URL=redis://:change-me-redis-password@redis:6379
MYSQL_URL=mysql://dsc:change-me-db-password@mysql:3306/device_state_console
# External examples:
# MYSQL_URL=mysql://guanlan:secret@db.example.internal:3306/guanlan_home
# REDIS_URL=rediss://:secret@redis.example.internal:6379/3
# DSC_INSTANCE_ID=hub-home

# Connection pool and remote-database timeouts (milliseconds).
MYSQL_POOL_SIZE=10
MYSQL_QUEUE_LIMIT=128
MYSQL_CONNECT_TIMEOUT_MS=5000
MYSQL_QUERY_TIMEOUT_MS=15000
MYSQL_IDLE_TIMEOUT_MS=60000
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=5000
# Bounded server-side read caches. Set a TTL to 0 to disable that tier.
DSC_DEVICE_CACHE_TTL_MS=3000
DSC_HISTORY_CACHE_TTL_MS=15000
DSC_CALENDAR_CACHE_TTL_MS=60000
DSC_CACHE_MAX_ENTRIES=512
DSC_CACHE_MAX_BYTES=67108864
# Optional Redis L2 cache for multiple Hub processes or warm restarts.
DSC_REDIS_CACHE_ENABLED=false
# Set false only when the Agent endpoint is intentionally exposed over trusted HTTP.
AGENT_REQUIRE_HTTPS=true
CORS_ORIGINS=https://console.example.com
# Release update metadata. Test releases may upgrade to a newer test or stable release;
# stable releases only upgrade to newer stable releases.
DSC_VERSION=0.2.302
DSC_RELEASE_CHANNEL=test
DSC_RELEASE_REPOSITORY=IGNGserver/guanlan-monitor
# Optional App Store/TestFlight URL for iOS update prompts.
# DSC_IOS_UPDATE_URL=https://testflight.apple.com/join/...
# Keep automatic Hub deployment disabled until the deployment token and protected
# environment are configured deliberately.
DSC_HUB_UPDATE_ENABLED=false
# DSC_GITHUB_TOKEN=...
# Test Hub updates use an isolated test environment; stable Hub updates use production.
# DSC_HUB_TEST_UPDATE_WORKFLOW=deploy-test.yml
# DSC_HUB_STABLE_UPDATE_WORKFLOW=deploy-production.yml
# AGENT_SHARED_SECRET is deprecated and ignored when ACCESS_KEY is set.
NEXT_PUBLIC_SERVER_URL=http://server:4000
