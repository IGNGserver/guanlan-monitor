---
/**
 * 观澜标识：产品图标（屏幕 + 琥珀脉冲 + 青色在线点）的矢量复刻，不另造字标。
 * 脉冲走势与 design/observatory.json 的 pulse 同源。
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <rect x="3.5" y="6.5" width="25" height="19" rx="5" stroke="currentColor" stroke-opacity="0.85" stroke-width="1.4"></rect>
  <polyline
    points="6,17 12.8,17 13.7,18.2 14.9,11 16,20.6 17.1,15.2 18.1,17 26,17"
    stroke="#ffa64a"
    stroke-width="1.6"
    stroke-linejoin="round"
    stroke-linecap="round"></polyline>
  <circle cx="24" cy="10.6" r="1.6" fill="#35d8b6"></circle>
</svg>
