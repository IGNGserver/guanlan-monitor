---
import { HUB_ENV_KEYS, HUB_EXTERNAL_SERVICES, HUB_PORT, HUB_SERVICES } from '../data/product';
---

<section id="hub" class="hub section" data-idx="07" aria-labelledby="hub-title" data-hub>
  <div class="wrap hub__grid">
    <div class="hub__copy">
      <p class="eyebrow" data-reveal>§ 07 · 中枢</p>
      <h2 id="hub-title" class="display" data-reveal style="--d:1">中枢，<br />部署在你自己的<br />服务器上。</h2>
      <p class="lede" data-reveal style="--d:2">
        Docker Compose 默认只拉取 GitHub Container Registry 中已发布的镜像，不从源码构建。既可一键起齐四容器全栈，也可接入已有的外部 MySQL 8.0+ 与 Redis。
      </p>

      <div class="hub__modes mono" role="group" aria-label="中枢部署拓扑" data-reveal>
        <button type="button" data-hub-mode="bundled" aria-pressed="true">
          内置全栈 · 4 容器
        </button>
        <button type="button" data-hub-mode="external" aria-pressed="false">
          外部数据库 · 2 容器 + 共享库
        </button>
      </div>

      <ol class="hub__steps" data-hub-view="bundled">
        <li data-reveal>
          <span class="mono amber">01</span>
          <div>
            <p>准备配置</p>
            <pre class="code"><code>cp .env.example .env</code></pre>
            <p class="faint hub__keys">
              至少修改 {HUB_ENV_KEYS.map((k, i) => (<><code>{k}</code>{i < HUB_ENV_KEYS.length - 1 ? '、' : ''}</>))}，并为 <code>REDIS_URL</code> 配置相同的认证密码。
            </p>
          </div>
        </li>
        <li data-reveal>
          <span class="mono amber">02</span>
          <div>
            <p>拉取并启动</p>
            <pre class="code"><code><span class="k">DSC_VERSION</span>=&lt;版本号&gt; docker compose pull
<span class="k">DSC_VERSION</span>=&lt;版本号&gt; docker compose up -d</code></pre>
          </div>
        </li>
        <li data-reveal>
          <span class="mono amber">03</span>
          <div>
            <p>接入设备</p>
            <p class="faint">在各客户端与 Agent 中填写同一个入口，例如 <code>https://服务器域名:{HUB_PORT}</code>。</p>
          </div>
        </li>
      </ol>

      <ol class="hub__steps" data-hub-view="external" hidden>
        <li>
          <span class="mono amber">01</span>
          <div>
            <p>指向外部数据库与实例 ID</p>
            <pre class="code"><code>DSC_DB_MODE=external
DSC_INSTANCE_ID=hub-home
MYSQL_URL=mysql://guanlan:...@db.internal:3306/guanlan_home
REDIS_URL=rediss://:...@redis.internal:6379/3</code></pre>
            <p class="faint hub__keys">
              每个中枢独占一个 MySQL database（写入 <code>hub_meta</code> + 单写者锁），并通过 <code>dsc:&lt;DSC_INSTANCE_ID&gt;</code> 隔离共享 Redis 的键空间。
            </p>
          </div>
        </li>
        <li>
          <span class="mono amber">02</span>
          <div>
            <p>仅启动应用容器</p>
            <pre class="code"><code><span class="k">DSC_VERSION</span>=&lt;版本号&gt; docker compose -f docker-compose.external.yml pull
<span class="k">DSC_VERSION</span>=&lt;版本号&gt; docker compose -f docker-compose.external.yml up -d</code></pre>
          </div>
        </li>
        <li>
          <span class="mono amber">03</span>
          <div>
            <p>保持数据库仅内网可达</p>
            <p class="faint"><code>docker-compose.external.yml</code> 不创建也不暴露数据库端口；客户端入口仍是同一个 <code>:{HUB_PORT}</code>。</p>
          </div>
        </li>
      </ol>

      <a class="btn" href="/deploy/" data-reveal>
        完整部署说明
        <svg class="arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.4" fill="none"></path></svg>
      </a>
    </div>

    <div class="stack" data-reveal aria-label="中枢服务结构">
      <div class="stack__port">
        <span class="label">对外公开入口</span>
        <span class="mono">:{HUB_PORT}</span>
      </div>

      <div class="stack__group" data-hub-view="bundled">
        {
          HUB_SERVICES.map((s, i) => (
            <div class={`slab slab--${s.id}`} style={`--i:${i}`}>
              <div class="slab__face">
                <span class="slab__name mono">{s.name}</span>
                <span class="slab__role">{s.role}</span>
                <span class="slab__port mono">{s.port}</span>
              </div>
            </div>
          ))
        }
        <p class="stack__cap label">docker-compose.yml · 4 services</p>
      </div>

      <div class="stack__group" data-hub-view="external" hidden>
        {
          HUB_EXTERNAL_SERVICES.map((s, i) => (
            <div class:list={['slab', `slab--${s.id}`, { 'slab--ext': 'external' in s && s.external }]} style={`--i:${i}`}>
              <div class="slab__face">
                <span class="slab__name mono">{s.name}</span>
                <span class="slab__role">{s.role}</span>
                <span class="slab__port mono">{s.port}</span>
              </div>
            </div>
          ))
        }
        <p class="stack__cap label">docker-compose.external.yml · 2 app containers + external DB</p>
      </div>
    </div>
  </div>
</section>

<script>
  const hub = document.querySelector<HTMLElement>('[data-hub]');
  if (hub) {
    const btns = Array.from(hub.querySelectorAll<HTMLButtonElement>('[data-hub-mode]'));
    const views = Array.from(hub.querySelectorAll<HTMLElement>('[data-hub-view]'));
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        const mode = b.dataset.hubMode;
        btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        views.forEach((v) => (v.hidden = v.dataset.hubView !== mode));
      }),
    );
  }
</script>

<style>
  .hub {
    z-index: 1;
    background: var(--void);
    border-top: 1px solid var(--line);
  }

  .hub__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(48px, 7vw, 120px);
    align-items: center;
  }

  .hub__copy .lede {
    margin-top: 28px;
  }

  .hub__modes {
    display: inline-flex;
    flex-wrap: wrap;
    margin-top: 28px;
    border: 1px solid var(--line-2);
    background: var(--ink-1);
  }

  .hub__modes button {
    height: 36px;
    padding: 0 14px;
    border: 0;
    background: none;
    color: var(--bone-3);
    font-size: 12px;
    cursor: pointer;
    transition:
      color 0.2s,
      background 0.2s;
  }

  .hub__modes button + button {
    border-left: 1px solid var(--line);
  }

  .hub__modes button[aria-pressed='true'] {
    color: var(--amber);
    background: rgb(255 166 74 / 0.08);
  }

  .hub__steps {
    list-style: none;
    margin: 28px 0 36px;
    padding: 0;
    display: grid;
    gap: 22px;
  }

  .hub__steps[hidden],
  .stack__group[hidden] {
    display: none;
  }

  .hub__steps li {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 12px;
  }

  .hub__steps li > span {
    padding-top: 2px;
    font-size: 12px;
  }

  .hub__steps p {
    font-size: 14.5px;
  }

  .hub__steps .code {
    margin-top: 10px;
  }

  .hub__steps .faint,
  .hub__keys {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.8;
  }

  .hub__steps code {
    color: var(--bone-2);
  }

  .stack {
    position: relative;
    display: grid;
    gap: 14px;
    padding: 8px 48px 24px 0;
    perspective: 1600px;
  }

  .stack__group {
    display: grid;
    gap: 14px;
  }

  .stack__port {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 14px;
    margin-bottom: 6px;
    border-bottom: 1px dashed rgb(255 166 74 / 0.35);
    font-size: 30px;
    color: var(--amber);
  }

  .slab {
    transform-style: preserve-3d;
    transform: rotateX(16deg) rotateY(-14deg) translateX(calc(var(--i) * 14px));
    transform-origin: 50% 0;
    transition: transform 1.2s var(--ease);
  }

  .stack:hover .slab {
    transform: rotateX(10deg) rotateY(-8deg) translateX(calc(var(--i) * 22px));
  }

  .slab__face {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 22px 26px;
    border: 1px solid var(--line-3);
    background: linear-gradient(135deg, var(--ink-3), var(--ink-1));
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.04) inset,
      0 24px 48px -24px rgb(0 0 0 / 0.9);
  }

  .slab--web .slab__face {
    border-color: rgb(255 166 74 / 0.6);
    box-shadow:
      0 0 0 1px rgb(255 166 74 / 0.12),
      0 0 60px -10px rgb(255 166 74 / 0.25);
  }

  .slab--ext .slab__face {
    border-style: dashed;
    border-color: rgb(53 216 182 / 0.45);
    background: linear-gradient(135deg, rgb(12 24 24 / 0.88), var(--ink-1));
  }

  .slab--ext .slab__name {
    color: var(--teal);
  }

  .slab__name {
    font-size: 16px;
    color: var(--amber);
    min-width: 5ch;
  }

  .slab__role {
    font-size: 13.5px;
    color: var(--bone-2);
  }

  .slab__port {
    font-size: 11.5px;
    color: var(--bone-3);
  }

  .stack__cap {
    margin-top: 28px;
    text-align: center;
  }

  @media (max-width: 960px) {
    .hub__grid {
      grid-template-columns: 1fr;
    }

    .stack {
      padding-top: 32px;
      padding-right: 16px;
    }
  }

  @media (max-width: 520px) {
    .slab {
      transform: none;
    }

    .stack:hover .slab {
      transform: none;
    }

    .slab__face {
      grid-template-columns: 1fr auto;
      padding: 16px;
    }

    .slab__role {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .stack__port {
      position: static;
      flex-direction: row;
      align-items: baseline;
      gap: 12px;
      font-size: 20px;
    }
  }
</style>
