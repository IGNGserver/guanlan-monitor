---
/**
 * 固定在视口后方的 3D 舞台。先显示 Blender 渲染静帧（也是无 WebGL / 减少动态时的最终画面），
 * three 场景就绪后画布淡入。层标签与引线也挂在这里，与画布同一坐标系。
 */
import { getImage } from 'astro:assets';
import hero from '../assets/renders/hero.webp';
import portrait from '../assets/renders/hero-portrait.webp';
import { SPEC } from '../scripts/observatory/spec';

const names = SPEC.layers.map((l) => l.label);
const set = async (src: ImageMetadata, widths: number[], format: 'avif' | 'webp') => {
  const imgs = await Promise.all(widths.map((width) => getImage({ src, width, format, quality: 70 })));
  return imgs.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
};
const wide = [960, 1440, 1920, 2560];
const tall = [540, 810, 1080];
const fallback = await getImage({ src: hero, width: 1920, format: 'webp', quality: 72 });
---

<div class="stage" data-stage aria-hidden="true">
  <picture class="stage__poster">
    <source media="(max-width: 899px) and (orientation: portrait)" type="image/avif" srcset={await set(portrait, tall, 'avif')} sizes="100vw" />
    <source media="(max-width: 899px) and (orientation: portrait)" type="image/webp" srcset={await set(portrait, tall, 'webp')} sizes="100vw" />
    <source type="image/avif" srcset={await set(hero, wide, 'avif')} sizes="100vw" />
    <source type="image/webp" srcset={await set(hero, wide, 'webp')} sizes="100vw" />
    <img src={fallback.src} alt="" width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async" />
  </picture>
  <canvas class="stage__canvas"></canvas>
  <div class="stage__shade"></div>
  <svg class="stage__lead" width="100%" height="100%"><line data-lead x1="0" y1="0" x2="0" y2="0"></line></svg>
  <div class="stage__tags">
    {
      names.map((n, i) => (
        <span class="tag3d" data-tag={i}>
          <i />
          <b class="mono">{String(names.length - 1 - i).padStart(2, '0')}</b>
          {n}
        </span>
      ))
    }
  </div>
</div>

<script>
  import { boot } from '../scripts/observatory/director';
  boot();
</script>

<style>
  .stage {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    background: var(--void);
  }

  .stage__poster,
  .stage__poster :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    transition: opacity 1.2s var(--ease);
  }

  .stage__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease);
  }

  .stage.is-live .stage__canvas {
    opacity: 1;
  }

  .stage.is-live .stage__poster,
  .stage.is-live .stage__poster :global(img) {
    opacity: 0;
  }

  .stage__shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 80% at 50% 40%, transparent 55%, rgb(6 8 11 / 0.65) 100%),
      linear-gradient(to bottom, rgb(6 8 11 / 0.5), transparent 18%, transparent 78%, rgb(6 8 11 / 0.7));
  }

  .stage__lead {
    position: absolute;
    inset: 0;
  }

  .stage__lead line {
    stroke: var(--amber);
    stroke-width: 1;
    stroke-dasharray: 2 4;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .stage__tags {
    position: absolute;
    inset: 0;
  }

  .tag3d {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: -9px;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--bone-2);
    white-space: nowrap;
    opacity: 0;
    will-change: transform, opacity;
  }

  .tag3d i {
    display: block;
    width: 28px;
    height: 1px;
    background: var(--line-3);
  }

  .tag3d b {
    font-weight: 400;
    font-size: 10px;
    color: var(--bone-3);
  }

  .tag3d.is-focus {
    color: var(--amber);
  }

  .tag3d.is-focus i {
    background: var(--amber);
    width: 44px;
  }

  .tag3d.is-focus b {
    color: var(--amber);
  }

  :global(html.no-gl) .stage__canvas,
  :global(html.no-gl) .stage__tags,
  :global(html.no-gl) .stage__lead {
    display: none;
  }

  @media (max-width: 899px) {

    .stage__tags {
      display: none;
    }
  }
</style>
