---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import {
  CLIENT_UPDATES_DOC_URL,
  COMPOSE_URL,
  ENV_EXAMPLE_URL,
  EXTERNAL_COMPOSE_URL,
  EXTERNAL_DB_DOC_URL,
  HUB_ADDRESSES,
  HUB_PORT,
  INSTALL_DOC_URL,
  REALTIME_DOC_URL,
} from '../data/product';

const env = [
  ['SESSION_SECRET', '控制台会话签名密钥；修改会使全部 Web 会话立即失效，不影响 Agent', true],
  ['ACCESS_KEY', '网页、桌面端 / Android 客户端和所有 Agent 共用的唯一访问密钥；升级时即使旧 .env 仍有 AGENT_SHARED_SECRET，也以它为准', true],
  ['MYSQL_ROOT_PASSWORD', '内置 MySQL root 密码（稳定版要求至少 16 个字符）', true],
  ['MYSQL_PASSWORD', '应用数据库用户密码（建议使用高强度随机值）', true],
  ['REDIS_PASSWORD', 'Redis 认证密码；REDIS_URL 需配置相同的密码', true],
  ['DSC_TRUSTED_TLS_PROXY_CIDRS', '外层代理终止 TLS 时，填写 Web 容器实际看到的代理源 IP / CIDR（空格分隔）；默认空列表不信任任何 X-Forwarded-Proto', false],
  ['TRUST_PROXY', '只有当 server 仅能从受信反向代理访问时才设为 true，否则保持 false', false],
  ['SESSION_COOKIE_SECURE', '默认 true；仅在明确受信的 HTTP 网络中改为 false', false],
  ['AGENT_REQUIRE_HTTPS', '默认 true；仅在明确受信的 HTTP 网络中改为 false', false],
] as const;

const toc = [
  ['prep', '准备'],
  ['env', '配置 .env'],
  ['up', '启动'],
  ['external', '使用已有 MySQL / Redis'],
  ['proxy', '反向代理与 TLS'],
  ['connect', '接入设备'],
  ['ops', '升级与备份'],
];
---

<Base title="部署中枢" path="/deploy/" description="用 Docker Compose 在自己的服务器上部署观澜中枢：内置全栈、外部数据库、TLS 转发白名单与接入设备。">
  <PageHead
    index="HUB"
    eyebrow="部署中枢"
    title="部署中枢"
    lede={`中枢以 Docker Compose 运行，默认只拉取 GitHub Container Registry 中已发布的镜像。既可起齐四容器全栈，也可连接已有 MySQL 与 Redis；所有客户端与 Agent 共用同一个公开入口（默认端口 ${HUB_PORT}）。`}
  >
    <nav class="toc" slot="aside" aria-label="本页目录">
      <p class="label">本页</p>
      {
        toc.map(([id, t], i) => (
          <a href={`#${id}`}>
            <span class="mono faint">{String(i + 1).padStart(2, '0')}</span>
            {t}
          </a>
        ))
      }
    </nav>
  </PageHead>

  <article class="wrap doc">
    <section id="prep" class="step">
      <p class="step__n mono">01</p>
      <div>
        <h2>准备</h2>
        <p>一台能运行 Docker 与 Docker Compose 的服务器。从产品仓库取得 <a href={COMPOSE_URL} rel="noopener"><code>docker-compose.yml</code></a>（或外部库拓扑的 <a href={EXTERNAL_COMPOSE_URL} rel="noopener"><code>docker-compose.external.yml</code></a>）与 <a href={ENV_EXAMPLE_URL} rel="noopener"><code>.env.example</code></a>，放在同一目录。</p>
        <div class="svc">
          <div><span class="mono amber">web</span><span>控制台（Nginx），映射 <code>{HUB_PORT}:3000</code>，固定将 <code>/api/**</code> 转发至 Compose 内的 <code>server:4000</code></span></div>
          <div><span class="mono amber">server</span><span>中枢服务（容器内 4000 端口，不对外），数据目录挂载 <code>./data</code></span></div>
          <div><span class="mono amber">redis</span><span>Redis 7.4，开启 AOF 与密码认证，承载实时状态与可选 L2 缓存</span></div>
          <div><span class="mono amber">mysql</span><span>MySQL 8.4，utf8mb4，存储设备组、历史趋势与流量日历</span></div>
        </div>
      </div>
    </section>

    <section id="env" class="step">
      <p class="step__n mono">02</p>
      <div>
        <h2>配置 .env</h2>
        <pre class="code"><code>cp .env.example .env</code></pre>
        <p>内置全栈至少修改标记为「必须」的五项。生产环境默认通过 TLS 反向代理访问控制台；Web 登录会话默认有效 90 天并自动滑动续期（上限 365 天）。</p>
        <div class="envt" role="table" aria-label=".env 关键项">
          {
            env.map(([k, v, must]) => (
              <div role="row">
                <span role="cell" class="mono">{k}</span>
                <span role="cell">{v}</span>
                <span role="cell" class:list={['envt__must', { on: must }]}>{must ? '必须' : '按需'}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="up" class="step">
      <p class="step__n mono">03</p>
      <div>
        <h2>启动</h2>
        <p>生产环境必须使用固定版本或不可变 digest：</p>
        <pre class="code"><code><span class="k">DSC_VERSION</span>=&lt;版本号&gt; docker compose pull
<span class="k">DSC_VERSION</span>=&lt;版本号&gt; docker compose up -d</code></pre>
        <p>开发或测试环境如果确实需要移动标签，可以显式选择 <code>latest</code>：</p>
        <pre class="code"><code><span class="k">DSC_VERSION</span>=latest docker compose pull
<span class="k">DSC_VERSION</span>=latest docker compose up -d</code></pre>
        <p class="faint">server 提供 <code>/api/health/readiness</code> 与 <code>/api/health/liveness</code> 探测端点。</p>
      </div>
    </section>

    <section id="external" class="step">
      <p class="step__n mono">04</p>
      <div>
        <h2>使用已有 MySQL 与 Redis</h2>
        <p>服务器已有供多个项目共用的 MySQL 8.0+ 与开启认证的 Redis 时，可使用只包含 <code>web</code> 与 <code>server</code> 的 <a href={EXTERNAL_COMPOSE_URL} rel="noopener"><code>docker-compose.external.yml</code></a>：</p>
        <pre class="code"><code><span class="c"># 在 .env 中设置：</span>
DSC_DB_MODE=external
DSC_INSTANCE_ID=hub-home
MYSQL_URL=mysql://guanlan:...@db.internal:3306/guanlan_home
REDIS_URL=rediss://:...@redis.internal:6379/3

<span class="k">DSC_VERSION</span>=&lt;版本号&gt; docker compose -f docker-compose.external.yml pull
<span class="k">DSC_VERSION</span>=&lt;版本号&gt; docker compose -f docker-compose.external.yml up -d</code></pre>
        <ul class="list">
          <li><strong>独立数据库与单写者锁</strong>：每个中枢必须独占一个 MySQL database；启动时校验 <code>hub_meta.instance_id</code> 并持有 MySQL advisory lock，拒绝多实例同时写同一库。</li>
          <li><strong>Redis 命名空间隔离</strong>：外部模式要求非 <code>default</code> 的 <code>DSC_INSTANCE_ID</code>，所有键统一带 <code>dsc:&lt;instance-id&gt;</code> 前缀；开启 <code>DSC_REDIS_CACHE_ENABLED=true</code> 时建议配合 <code>volatile-lru</code>。</li>
          <li>数据库与 Redis 应保持在内网或 VPN 内，不要暴露到公网，也不要与会重声明内置数据库服务的覆盖文件混用。</li>
        </ul>
        <a class="more" href={EXTERNAL_DB_DOC_URL} rel="noopener">外部数据库契约与迁移步骤 ↗</a>
      </div>
    </section>

    <section id="proxy" class="step">
      <p class="step__n mono">05</p>
      <div>
        <h2>反向代理与 TLS</h2>
        <ul class="list">
          <li>默认建议 HTTPS。<code>SESSION_COOKIE_SECURE</code> 与 <code>AGENT_REQUIRE_HTTPS</code> 默认开启；只有在明确受信的网络中才改用 HTTP。</li>
          <li>外层代理终止 TLS 并以 HTTP 转发到 Web 容器时，必须在 <code>DSC_TRUSTED_TLS_PROXY_CIDRS</code> 中填入 Web 容器实际看到的代理源 IP / CIDR，并由该代理覆盖 <code>X-Forwarded-Proto</code>；不要填入客户端网段或共享 NAT 地址。</li>
          <li>只有当 server 仅能从受信代理访问时才设置 <code>TRUST_PROXY=true</code>。</li>
          <li>实时查看依赖 Agent 主动连接 <code>/api/agent/realtime</code>：外部入口、反向代理或 FRP / NPS 需要允许该路径的 WebSocket Upgrade，空闲超时应大于 20 秒。</li>
          <li>中枢为单写者架构，实时通道与数据库写锁均面向单副本中枢进程，不能直接横向多副本复制。</li>
        </ul>
        <a class="more" href={REALTIME_DOC_URL} rel="noopener">实时通道的完整约束 ↗</a>
      </div>
    </section>

    <section id="connect" class="step">
      <p class="step__n mono">06</p>
      <div>
        <h2>接入设备</h2>
        <p>在各终端填写同一个公开入口与 <code>ACCESS_KEY</code>。不要把 Docker 容器内部的 <code>4000</code> 端口填入客户端。</p>
        <dl class="addrs">
          {
            HUB_ADDRESSES.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd class="mono">{v}</dd>
              </div>
            ))
          }
        </dl>
        <p>然后 <a href="/download/">下载客户端</a>，或在无桌面的机器上用静默参数安装。若重装系统导致设备实时凭据冲突，可在控制台设备详情页显式重置实时凭据。</p>
      </div>
    </section>

    <section id="ops" class="step">
      <p class="step__n mono">07</p>
      <div>
        <h2>升级与备份</h2>
        <ul class="list">
          <li>中枢升级：把 <code>DSC_VERSION</code> 换成新的固定版本，重新 <code>pull</code> 与 <code>up -d</code>。</li>
          <li>备份：内置模式备份 <code>mysql-data</code>、<code>redis-data</code> 与 <code>./data</code>；外部模式备份外部 MySQL 库与中枢本机的 <code>./data</code>（内含实时通道设备凭据哈希与本地配置）。</li>
          <li>设备端升级：桌面端、Android 或无桌面机器的 <code>guanlan-agent update --channel stable|preview</code> 直接读取仓库静态更新源，流式校验字节数与 SHA-256 后调用系统安装器升级，保留机器级配置。</li>
        </ul>
        <p class="doc__links">
          <a class="more" href={INSTALL_DOC_URL} rel="noopener">部署与安装指南 ↗</a>
          <a class="more" href={CLIENT_UPDATES_DOC_URL} rel="noopener">设备更新机制 ↗</a>
        </p>
      </div>
    </section>
  </article>
</Base>

<style>
  .toc {
    display: grid;
    gap: 2px;
    min-width: 210px;
    padding: 18px 20px;
    border: 1px solid var(--line-2);
    background: rgb(10 13 17 / 0.8);
  }

  .toc .label {
    margin-bottom: 8px;
  }

  .toc a {
    display: flex;
    gap: 12px;
    padding: 5px 0;
    font-size: 14px;
    color: var(--bone-2);
  }

  .toc a:hover {
    color: var(--amber);
  }

  .doc {
    padding-top: 40px;
    padding-bottom: 140px;
  }

  .step {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 32px;
    padding: 56px 0;
    border-top: 1px solid var(--line);
    max-width: 1080px;
  }

  .step__n {
    font-size: 44px;
    font-weight: 200;
    color: var(--amber);
    line-height: 1;
  }

  .step h2 {
    font-family: var(--font-cjk);
    font-weight: 300;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    margin-bottom: 18px;
  }

  .step p {
    color: var(--bone-2);
    font-size: 15px;
    line-height: 1.85;
  }

  .step p + p,
  .step .code + p,
  .step p + .code {
    margin-top: 14px;
  }

  .step a {
    color: var(--amber);
  }

  .step code {
    color: var(--bone);
  }

  .step .code {
    margin: 14px 0;
  }

  .svc {
    display: grid;
    gap: 1px;
    margin-top: 22px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .svc div {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 16px;
    padding: 12px 16px;
    background: var(--ink-1);
    font-size: 14px;
    color: var(--bone-2);
  }

  .envt {
    display: grid;
    gap: 1px;
    margin-top: 18px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .envt div {
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr) 56px;
    gap: 16px;
    padding: 12px 16px;
    background: var(--void);
    font-size: 13.5px;
    color: var(--bone-2);
  }

  .envt .mono {
    color: var(--bone);
    font-size: 12.5px;
    overflow-wrap: anywhere;
  }

  .envt__must {
    font-size: 12px;
    color: var(--bone-3);
    text-align: right;
  }

  .envt__must.on {
    color: var(--amber);
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }

  .list li {
    position: relative;
    padding-left: 20px;
    font-size: 15px;
    line-height: 1.8;
    color: var(--bone-2);
  }

  .list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 8px;
    height: 1px;
    background: var(--amber);
  }

  .more {
    display: inline-block;
    margin-top: 18px;
    font-size: 14px;
  }

  .doc__links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  .addrs {
    margin: 18px 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .addrs div {
    padding: 12px 16px;
    background: var(--ink-1);
  }

  .addrs dt {
    font-size: 12px;
    color: var(--bone-3);
  }

  .addrs dd {
    margin: 4px 0 0;
    font-size: 13px;
    overflow-wrap: anywhere;
  }

  @media (max-width: 760px) {
    .step {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 40px 0;
    }

    .step__n {
      font-size: 28px;
    }

    .envt div {
      grid-template-columns: 1fr auto;
    }

    .envt div span:nth-child(2) {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .addrs,
    .svc div {
      grid-template-columns: 1fr;
    }

    .svc div {
      gap: 4px;
    }
  }
</style>
