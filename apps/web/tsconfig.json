{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "noEmit": true,
    "isolatedModules": true,
    "baseUrl": "../..",
    "paths": {
      "@dsc/shared": ["packages/shared/src/index.ts"],
      "@dsc/shared/*": ["packages/shared/src/*"],
      "@dsc/console-ui": ["packages/console-ui/src/index.ts"],
      "@dsc/console-ui/*": ["packages/console-ui/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
