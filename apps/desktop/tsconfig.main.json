{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": "../..",
    "paths": {
      "@dsc/shared": ["packages/shared/dist/index.d.ts"],
      "@dsc/shared/*": ["packages/shared/dist/*"],
      "@dsc/console-ui": ["packages/console-ui/src/index.ts"],
      "@dsc/console-ui/*": ["packages/console-ui/src/*"]
    },
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts"],
  "exclude": ["src/main/**/*.test.ts"]
}
