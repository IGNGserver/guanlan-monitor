{
  "name": "@dsc/desktop",
  "version": "0.2.275",
  "private": true,
  "type": "module",
  "description": "Unified Windows and Linux Electron desktop client for Device State Console.",
  "author": {
    "name": "Device State Console contributors",
    "email": "github-actions@github.com"
  },
  "homepage": "https://github.com/IGNGserver/guanlan-monitor",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
    "dev": "vite --host 127.0.0.1",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:desktop-ui-boundaries": "node ../../scripts/check-desktop-ui-boundaries.mjs",
    "test:ui-helpers": "node --test ../../packages/console-ui/src/helpers/layout.test.ts",
    "package:windows": "pnpm build && electron-builder --win nsis portable",
    "package:linux": "pnpm build && electron-builder --linux deb"
  },
  "dependencies": {
    "@dsc/shared": "workspace:*",
    "@dsc/console-ui": "workspace:*",
    "clsx": "^2.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.0.6"
  },
  "build": {
    "appId": "org.igng.devicestateconsole",
    "productName": "观澜",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../release/desktop-agent",
        "to": "agent",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../windows-agent/DeviceStateConsoleAgent.WinUI/Assets/app-icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "win": {
      "icon": "../../windows-agent/DeviceStateConsoleAgent.WinUI/Assets/app-icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "DeviceStateConsole-Windows-GUI-Setup-v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "观澜",
      "uninstallDisplayName": "观澜 version ${version}",
      "guid": "E7EC0D43-10D7-4D88-BB80-6F1E901C3E7A",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "DeviceStateConsole-Windows-GUI-Portable-v${version}.${ext}"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Device State Console contributors <github-actions@github.com>",
      "artifactName": "DeviceStateConsole-Linux-GUI-Install-v${version}.${ext}"
    }
  }
}
