{
  "name": "@dsc/desktop",
  "version": "0.2.63",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
    "dev": "vite --host 127.0.0.1",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:windows": "pnpm build && electron-builder --win nsis portable",
    "package:linux": "pnpm build && electron-builder --linux deb"
  },
  "dependencies": {
    "@dsc/shared": "workspace:*",
    "clsx": "^2.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.0.6"
  },
  "build": {
    "appId": "org.igng.devicestateconsole",
    "productName": "Device State Console",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../release/desktop-agent",
        "to": "agent",
        "filter": ["**/*"]
      },
      {
        "from": "../../windows-agent/DeviceStateConsoleAgent.WinUI/Assets/app-icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "DeviceStateConsole-Windows-GUI-Setup-v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "DeviceStateConsole-Windows-GUI-Portable-v${version}.${ext}"
    },
    "linux": {
      "target": ["deb"],
      "category": "Utility",
      "artifactName": "DeviceStateConsole-Linux-GUI-Install-v${version}.${ext}"
    }
  }
}
