{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "baseUrl": "../..",
    "paths": {
      "@dsc/shared": ["packages/shared/src/index.ts"],
      "@dsc/shared/*": ["packages/shared/src/*"],
      "@dsc/console-ui": ["packages/console-ui/src/index.ts"],
      "@dsc/console-ui/*": ["packages/console-ui/src/*"]
    },
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts", "index.html"]
}
