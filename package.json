{
  "name": "guanlan-monitor",
  "private": true,
  "version": "3.0.160",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "rm -rf apps/server/dist apps/web/.next apps/web/tsconfig.tsbuildinfo packages/shared/dist",
    "dev": "pnpm --parallel --filter @dsc/server --filter @dsc/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check:desktop-ui-boundaries": "node scripts/check-desktop-ui-boundaries.mjs",
    "check:desktop-agent-state": "node scripts/check-desktop-agent-state.mjs",
    "check:web-ui-boundary": "node scripts/check-web-ui-boundary.mjs",
    "check:adapter-contracts": "node scripts/check-adapter-contracts.mjs",
    "check:ui-scale": "node scripts/check-ui-scale.mjs",
    "test:adapter-contracts": "node --test packages/console-ui/src/services/adapter.contract.test.ts",
    "test:ui-helpers": "node --test packages/console-ui/src/helpers/layout.test.ts packages/console-ui/src/helpers/presentation.test.ts",
    "test:workspace-contracts": "node --test packages/console-ui/src/workspace/routes.test.ts packages/console-ui/src/workspace/selectors.test.ts packages/console-ui/src/workspace/dashboard/dashboard.test.ts packages/console-ui/src/workspace/diagnostics.test.ts packages/console-ui/src/workspace/health.test.ts packages/console-ui/src/workspace/fleetTrends.test.ts packages/console-ui/src/workspace/chartIdentity.test.ts packages/console-ui/src/workspace/chartInspection.test.ts packages/console-ui/src/workspace/chartGeometry.test.ts packages/console-ui/src/workspace/configKeys.test.ts packages/console-ui/src/workspace/shell/captionGlyphs.test.ts packages/console-ui/src/workspace/livePresentation.test.ts packages/console-ui/src/workspace/hardwareFacts.test.ts",
    "test:renderer-security": "node --test apps/desktop/src/main/renderer-security.test.ts",
    "test:hub-connection": "node --test apps/desktop/src/main/agent-connection.test.ts",
    "test:macos-contracts": "node --test apps/desktop/src/main/platform.test.ts",
    "test:web-pwa": "node --test apps/web/src/lib/api.test.ts apps/web/src/lib/bootstrap-console.test.ts apps/web/src/lib/console-adapter.test.ts apps/web/src/lib/read-queue.test.ts apps/web/src/lib/offline-cache.test.ts apps/web/src/lib/offline-snapshot.test.ts apps/web/scripts/pwa-assets.test.mjs scripts/web-pwa.test.cjs",
    "test:loading-performance": "node --test packages/console-ui/src/helpers/loadingPerformance.test.ts packages/console-ui/src/helpers/networkPolicy.test.ts packages/console-ui/src/helpers/visiblePolling.test.ts scripts/loading-baseline.test.mjs",
    "test:desktop-loading": "node --experimental-transform-types --experimental-test-module-mocks --import ./scripts/desktop-source-hooks.mjs --test scripts/desktop-loading.test.mjs scripts/performance-regression.test.mjs",
    "performance:baseline": "node scripts/loading-baseline.mjs",
    "test:window-material": "node --test apps/desktop/src/window-material.test.ts",
    "test:electron-visual": "node scripts/electron-visual-regression.cjs",
    "verify:version": "node scripts/verify-version.mjs",
    "verify:electron-artifact-version": "node scripts/verify-electron-artifact-version.mjs",
    "verify:windows-installer": "node scripts/verify-windows-installer-config.mjs",
    "verify:linux-package": "node scripts/verify-linux-package-config.mjs",
    "verify:windows-hardware": "node scripts/verify-windows-hardware-integrity.mjs",
    "verify:web-security-headers": "node scripts/verify-web-security-headers.mjs",
    "verify:hub-image": "node scripts/verify-hub-image-config.mjs",
    "verify:hub-port": "node scripts/verify-hub-port.mjs"
  }
}
