{
  "name": "@dsc/console-ui",
  "version": "3.0.147",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./services/adapter": {
      "types": "./src/services/adapter.ts",
      "import": "./src/services/adapter.ts"
    },
    "./assets/*": "./src/assets/*",
    "./styles.css": "./src/styles.scss",
    "./styles.scss": "./src/styles.scss",
    "./window-material.css": "./src/workspace/window-material.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit && eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ui-helpers": "node --test src/helpers/layout.test.ts"
  },
  "dependencies": {
    "@dsc/shared": "workspace:*",
    "clsx": "^2.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "sass": "^1.93.2",
    "typescript": "^5.9.2"
  }
}
