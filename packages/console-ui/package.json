{
  "name": "@dsc/console-ui",
  "version": "3.0.53",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./assets/*": "./src/assets/*",
    "./styles.css": "./src/styles.scss",
    "./styles.scss": "./src/styles.scss",
    "./window-material.css": "./src/workspace/window-material.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ui-helpers": "node --test src/helpers/layout.test.ts"
  },
  "dependencies": {
    "@carbon/charts-react": "1.27.20",
    "@carbon/react": "1.116.0",
    "@dsc/shared": "workspace:*",
    "clsx": "^2.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "sass": "^1.93.2",
    "typescript": "^5.9.2"
  }
}
