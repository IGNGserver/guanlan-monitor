<Window
    x:Class="DeviceStateConsoleAgent.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:DeviceStateConsoleAgent.WinUI.Controls"
    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
    Title="观澜">
    <Grid x:Name="RootLayout" RequestedTheme="Default" UseLayoutRounding="True" SizeChanged="RootLayout_SizeChanged" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 系统融合标题栏 (Custom TitleBar Area) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="36" Background="Transparent" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                <FontIcon Glyph="&#xE970;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="观澜" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <controls:NavigationView x:Name="AppNavigation" Grid.Row="1"
                                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                  IsPaneOpen="True"
                                  IsPaneToggleButtonVisible="True"
                                  CompactPaneLength="56"
                                  OpenPaneLength="260"
                                  CompactModeThresholdWidth="0"
                                  ExpandedModeThresholdWidth="0"
                                  IsBackButtonVisible="Collapsed"
                                  IsSettingsVisible="False"
                                  PaneTitle="观澜"
                                  PaneDisplayMode="Left"
                                  SelectionChanged="NavigationView_SelectionChanged"
                                  BackRequested="NavigationView_BackRequested">
            <controls:NavigationView.MenuItems>
                <controls:NavigationViewItem Content="集群总览" Tag="overview" IsSelected="True">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="View" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
                <controls:NavigationViewItemSeparator />
                <controls:NavigationViewItemHeader Content="集群设备" />
            </controls:NavigationView.MenuItems>

            <controls:NavigationView.FooterMenuItems>
                <controls:NavigationViewItem Content="设置" Tag="settings">
                    <controls:NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></controls:NavigationViewItem.Icon>
                </controls:NavigationViewItem>
            </controls:NavigationView.FooterMenuItems>

            <Grid x:Name="ContentLayout" Padding="24,20,24,20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- 1. 集群总览页 (OverviewPage) -->
                <Grid x:Name="OverviewPage" Visibility="Visible">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <TextBlock Text="集群总览" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="{Binding ReleaseVersion}" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="全景展示受控集群设备的健康状态、硬件利用率与网络连接指标。" Style="{StaticResource BodyTextBlockStyle}" />
                            </StackPanel>

                            <Grid x:Name="OverviewUnavailableState" Visibility="Collapsed" MinHeight="360" HorizontalAlignment="Stretch">
                                <Border Style="{StaticResource DSCPanelStyle}" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,28">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                                        <FontIcon Glyph="&#xE711;" FontSize="40" HorizontalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                                            <TextBlock Text="无法连接中枢系统" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding ViewerDataStatusText}" Style="{StaticResource BodyTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0">
                                            <Button Content="重新检查连接" Command="{Binding CheckConnectionCommand}" Style="{StaticResource AccentButtonStyle}" />
                                            <Button Content="前往设置配置" Click="NavigateToSettings_OnClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 集群全景卡片列表 -->
                            <Grid x:Name="OverviewGrid" RowSpacing="16" HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBox Header="筛选集群设备" PlaceholderText="输入设备名称或设备 ID 过滤..." Text="{Binding ViewerDeviceFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="400" HorizontalAlignment="Left" />
                                <controls:ItemsRepeater Grid.Row="1" ItemsSource="{Binding FilteredViewerDevices}">
                                    <controls:ItemsRepeater.Layout>
                                        <controls:UniformGridLayout MinItemWidth="340" MinItemHeight="160" MinColumnSpacing="16" MinRowSpacing="16" />
                                    </controls:ItemsRepeater.Layout>
                                    <controls:ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="18" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                                                <Grid RowSpacing="12">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Hostname}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding DeviceId}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Padding="6,2" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusGlyph}" FontSize="12" Foreground="{Binding StatusColor}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="8" Margin="0,4,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding CpuText}" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MemoryText}" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DiskText}" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuText}" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    </Grid>
                                                    <Button Grid.Row="2" Content="进入设备大屏" Click="ViewerDeviceDetailsButton_OnClick" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </controls:ItemsRepeater.ItemTemplate>
                                </controls:ItemsRepeater>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 2. 任务管理器风格设备大屏页 (TaskManagerPage) -->
                <Grid x:Name="TaskManagerPage" Visibility="Collapsed">
                    <Grid ColumnSpacing="20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：指标类别 Sparkline 列表 (Task Manager Column) -->
                        <Border Grid.Column="0" Style="{StaticResource DSCPanelStyle}" Padding="8,12">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Spacing="4" Margin="8,4">
                                    <TextBlock Text="{Binding SelectedViewerDeviceName}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="性能与硬件资源" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- 类别选择列表 -->
                                <ListView x:Name="TaskManagerCategoryListView" Grid.Row="1" SelectionChanged="TaskManagerCategoryListView_SelectionChanged" BorderThickness="0" Background="Transparent">
                                    <!-- CPU Item -->
                                    <ListViewItem x:Name="CategoryItemCpu" Tag="cpu" Padding="8" Margin="0,0,0,6" CornerRadius="6">
                                        <Grid ColumnSpacing="12" Height="64">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource DSCSparklineFrameStyle}">
                                                <Canvas x:Name="CpuOverviewChart" SizeChanged="TrendCanvas_SizeChanged" Tag="cpu" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="CPU" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding ViewerDetailCpuText}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </ListViewItem>

                                    <!-- 内存 Item -->
                                    <ListViewItem x:Name="CategoryItemMemory" Tag="memory" Padding="8" Margin="0,0,0,6" CornerRadius="6">
                                        <Grid ColumnSpacing="12" Height="64">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource DSCSparklineFrameStyle}">
                                                <Canvas x:Name="MemoryOverviewChart" SizeChanged="TrendCanvas_SizeChanged" Tag="memory" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="内存" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding ViewerDetailMemoryText}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </ListViewItem>

                                    <!-- 磁盘 Item -->
                                    <ListViewItem x:Name="CategoryItemDisk" Tag="disk" Padding="8" Margin="0,0,0,6" CornerRadius="6">
                                        <Grid ColumnSpacing="12" Height="64">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource DSCSparklineFrameStyle}">
                                                <Canvas x:Name="DiskOverviewChart" SizeChanged="TrendCanvas_SizeChanged" Tag="disk" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="磁盘" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding ViewerDetailDiskText}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </ListViewItem>

                                    <!-- 网络 Item -->
                                    <ListViewItem x:Name="CategoryItemNetwork" Tag="network" Padding="8" Margin="0,0,0,6" CornerRadius="6">
                                        <Grid ColumnSpacing="12" Height="64">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource DSCSparklineFrameStyle}">
                                                <Canvas x:Name="NetworkOverviewChart" SizeChanged="TrendCanvas_SizeChanged" Tag="network" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="网络" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding ViewerDetailNetworkText}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </ListViewItem>

                                    <!-- 显卡 Item -->
                                    <ListViewItem x:Name="CategoryItemGpu" Tag="gpu" Padding="8" Margin="0,0,0,6" CornerRadius="6">
                                        <Grid ColumnSpacing="12" Height="64">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource DSCSparklineFrameStyle}">
                                                <Canvas x:Name="GpuOverviewChart" SizeChanged="TrendCanvas_SizeChanged" Tag="gpu" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="显卡" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding ViewerDetailGpuText}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </ListViewItem>

                                    <!-- 风扇 Item -->
                                    <ListViewItem x:Name="CategoryItemFan" Tag="fan" Padding="8" Margin="0,0,0,6" CornerRadius="6">
                                        <Grid ColumnSpacing="12" Height="64">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource DSCSparklineFrameStyle}">
                                                <Canvas x:Name="FanOverviewChart" SizeChanged="TrendCanvas_SizeChanged" Tag="fan" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="风扇" FontWeight="SemiBold" FontSize="15" />
                                                <TextBlock Text="{Binding ViewerDetailFanText}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </ListViewItem>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- 右侧：任务管理器详尽面板 (Main Detailed View) -->
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                                <!-- 顶部标题与硬件型号 -->
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock x:Name="TaskManagerCategoryTitle" Text="CPU" Style="{StaticResource TitleTextBlockStyle}" />
                                        <TextBlock x:Name="TaskManagerHardwareSubtitle" Text="{Binding SelectedViewerDeviceHardwareName}" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Header="历史窗口" ItemsSource="{Binding MetricWindows}" SelectedItem="{Binding SelectedMetricWindow, Mode=TwoWay}" SelectionChanged="MetricWindow_SelectionChanged" Width="140" VerticalAlignment="Bottom" />
                                </Grid>

                                <!-- 走势图面板 -->
                                <Border Style="{StaticResource DSCPanelStyle}" Padding="20">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="320" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <TextBlock Text="60 秒内的利用率 %" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="100%" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                        
                                        <!-- 图表或走势明细 -->
                                        <Grid Grid.Row="1" x:Name="TaskManagerChartContainer">
                                            <controls:ItemsRepeater x:Name="TaskManagerChartsRepeater" ItemsSource="{Binding CurrentCategoryCharts}">
                                                <controls:ItemsRepeater.Layout>
                                                    <controls:UniformGridLayout MinItemWidth="300" MinItemHeight="280" MinColumnSpacing="16" MinRowSpacing="12" />
                                                </controls:ItemsRepeater.Layout>
                                                <controls:ItemsRepeater.ItemTemplate>
                                                    <DataTemplate>
                                                        <local:MetricLineChart Chart="{Binding}" />
                                                    </DataTemplate>
                                                </controls:ItemsRepeater.ItemTemplate>
                                            </controls:ItemsRepeater>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- 照抄任务管理器的统计数据网格 (Standard Task Manager Metric Grid) -->
                                <Border Style="{StaticResource DSCPanelStyle}" Padding="20">
                                    <Grid ColumnSpacing="24" RowSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 第一栏：主要即时指标 -->
                                        <StackPanel Grid.Column="0" Spacing="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding TaskManagerStatLabel1}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding TaskManagerStatUsage}" FontSize="28" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding TaskManagerStatLabel2}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding TaskManagerStatSpeed}" FontSize="24" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding TaskManagerStatLabel3}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding TaskManagerStatCapacity}" FontSize="20" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 第二栏：活动与性能统计 -->
                                        <StackPanel Grid.Column="1" Spacing="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding TaskManagerStatLabel4}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding TaskManagerStatStatus}" FontSize="20" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding TaskManagerStatLabel5}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding TaskManagerStatWriteSpeed}" FontSize="20" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding TaskManagerStatLabel6}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding TaskManagerStatReadSpeed}" FontSize="20" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 第三栏：硬件固定规格参数 -->
                                        <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                                            <Grid><TextBlock Text="基准速度:" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock Text="{Binding TaskManagerBaseSpeedText}" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                            <Grid><TextBlock Text="物理内核:" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock Text="{Binding TaskManagerCoresText}" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                            <Grid><TextBlock Text="逻辑处理器:" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock Text="{Binding TaskManagerLogicalCpusText}" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                            <Grid><TextBlock Text="最后采集:" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock Text="{Binding TaskManagerLastSeenText}" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 3. 设置页面 (SettingsPage) -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="4">
                                <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="管理本机数据采集、传感器控制与中枢通信服务配置。" Style="{StaticResource BodyTextBlockStyle}" />
                            </StackPanel>

                            <!-- 设置选项分栏导航 -->
                            <Pivot x:Name="SettingsPivot" SelectionChanged="SettingsPivot_SelectionChanged">
                                <PivotItem Header="本机控制" Tag="local" />
                                <PivotItem Header="服务配置" Tag="server" />
                            </Pivot>

                            <!-- 3.1 本机控制面板 (LocalControlPanel) -->
                            <StackPanel x:Name="LocalControlPanel" Spacing="16" Visibility="Visible" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding LocalSampleTimestampText}" Style="{StaticResource CaptionTextBlockStyle}" />
                                <StackPanel x:Name="LocalMetricCardsGrid" Spacing="16" HorizontalAlignment="Stretch">
                                    <Border Style="{StaticResource DSCStatusCardStyle}" Padding="18">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="CPU" Style="{StaticResource SubtitleTextBlockStyle}" />
                                            <ToggleSwitch Header="采集" IsOn="{Binding CpuEnabled, Mode=TwoWay}" />
                                            <ComboBox Header="探测器" ItemsSource="{Binding CpuProviderOptions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding CpuProvider, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding RemoteCpuText}" Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock Text="{Binding LocalCpuPayloadText}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CpuInstanceSummary}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding CpuInstances}">
                                                <ItemsControl.ItemTemplate><DataTemplate><Grid ColumnSpacing="8" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ToggleSwitch Grid.Column="0" IsOn="{Binding IsEnabled, Mode=TwoWay}" /><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="配置" Click="InstanceMetricEditorButton_OnClick" IsEnabled="{Binding SupportsMetricEditing}" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DSCStatusCardStyle}" Padding="18">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="内存" Style="{StaticResource SubtitleTextBlockStyle}" />
                                            <ToggleSwitch Header="采集" IsOn="{Binding MemoryEnabled, Mode=TwoWay}" />
                                            <ComboBox Header="探测器" ItemsSource="{Binding MemoryProviderOptions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding MemoryProvider, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding RemoteMemoryText}" Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock Text="{Binding LocalMemoryPayloadText}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding MemoryMetricSummary}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DSCStatusCardStyle}" Padding="18">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="磁盘" Style="{StaticResource SubtitleTextBlockStyle}" />
                                            <ToggleSwitch Header="采集" IsOn="{Binding DiskEnabled, Mode=TwoWay}" />
                                            <ComboBox Header="探测器" ItemsSource="{Binding DiskProviderOptions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding DiskProvider, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding RemoteDiskText}" Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock Text="{Binding LocalDiskPayloadText}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DiskInstanceSummary}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding DiskInstances}">
                                                <ItemsControl.ItemTemplate><DataTemplate><Grid ColumnSpacing="8" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ToggleSwitch Grid.Column="0" IsOn="{Binding IsEnabled, Mode=TwoWay}" /><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="配置" Click="InstanceMetricEditorButton_OnClick" IsEnabled="{Binding SupportsMetricEditing}" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DSCStatusCardStyle}" Padding="18">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="网络" Style="{StaticResource SubtitleTextBlockStyle}" />
                                            <ToggleSwitch Header="采集" IsOn="{Binding NetworkEnabled, Mode=TwoWay}" />
                                            <ComboBox Header="探测器" ItemsSource="{Binding NetworkProviderOptions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding NetworkProvider, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding RemoteNetworkText}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding LocalNetworkPayloadText}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding NetworkInstanceSummary}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding NetworkInstances}">
                                                <ItemsControl.ItemTemplate><DataTemplate><Grid ColumnSpacing="8" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ToggleSwitch Grid.Column="0" IsOn="{Binding IsEnabled, Mode=TwoWay}" /><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="配置" Click="InstanceMetricEditorButton_OnClick" IsEnabled="{Binding SupportsMetricEditing}" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DSCStatusCardStyle}" Padding="18">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="显卡" Style="{StaticResource SubtitleTextBlockStyle}" />
                                            <ToggleSwitch Header="采集" IsOn="{Binding GpuEnabled, Mode=TwoWay}" />
                                            <ComboBox Header="探测器" ItemsSource="{Binding GpuProviderOptions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding GpuProvider, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding RemoteGpuText}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding GpuInstanceSummary}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding GpuInstances}">
                                                <ItemsControl.ItemTemplate><DataTemplate><Grid ColumnSpacing="8" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ToggleSwitch Grid.Column="0" IsOn="{Binding IsEnabled, Mode=TwoWay}" /><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /><Button Grid.Column="2" Content="配置" Click="InstanceMetricEditorButton_OnClick" IsEnabled="{Binding SupportsMetricEditing}" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DSCStatusCardStyle}" Padding="18">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="风扇" Style="{StaticResource SubtitleTextBlockStyle}" />
                                            <ToggleSwitch Header="采集" IsOn="{Binding FanEnabled, Mode=TwoWay}" />
                                            <ComboBox Header="探测器" ItemsSource="{Binding FanProviderOptions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding FanProvider, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding FanDetectStatusText}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- 3.2 服务配置面板 (ServerConfigPanel) -->
                            <StackPanel x:Name="ServerConfigPanel" Spacing="20" Visibility="Collapsed" HorizontalAlignment="Stretch">
                                <Border Style="{StaticResource DSCPanelStyle}">
                                    <StackPanel Spacing="14">
                                        <TextBox Header="中枢服务器地址" Text="{Binding ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="http://your-server-host:3100" />
                                        <PasswordBox x:Name="SecretBox" Header="访问密钥" PasswordChanged="SecretBox_OnPasswordChanged" />
                                        <ToggleSwitch Header="启用数据记录" IsOn="{Binding DataRecordingEnabled, Mode=TwoWay}" />
                                        <TextBlock Text="关闭后，本机不会注册至中枢，也不会上传监测数据。" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBox Header="设备 ID" Text="{Binding DeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataRecordingEnabled}" />
                                        <TextBox Header="设备名称" Text="{Binding Hostname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataRecordingEnabled}" />
                                        <ToggleSwitch Header="开机自动启动观澜" IsOn="{Binding LaunchAtStartup, Mode=TwoWay}" />
                                        <ToggleSwitch Header="开机时静默进入托盘" IsOn="{Binding StartMinimizedAtStartup, Mode=TwoWay}" />
                                        <Grid x:Name="ServerButtonsGrid" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Command="{Binding CheckConnectionCommand}" Content="验证连接与密钥" />
                                            <Button Grid.Column="1" Command="{Binding PushCloudCommand}" Content="保存并推送配置" />
                                        </Grid>
                                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="验证结果" Message="{Binding ConnectionCheckText}" />
                                        <TextBlock Text="{Binding ConnectionCheckDetailText}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="传输安全" Message="内网穿透或公网访问必须使用 https://。中枢开启 AGENT_REQUIRE_HTTPS=true 后，会拒绝明文 agent 上传、控制和数据查看请求。" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DSCPanelStyle}">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="上传策略" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <NumberBox Header="常规采样间隔（秒）" Minimum="1" Value="{Binding NormalIntervalValue, Mode=TwoWay}" />
                                        <NumberBox Header="慢速采样间隔（秒）" Minimum="5" Value="{Binding SlowIntervalValue, Mode=TwoWay}" />
                                        <ToggleSwitch Header="启动观澜时自动启动探测" IsOn="{Binding AutoStartCollector, Mode=TwoWay}" />
                                        <ToggleSwitch Header="采集器异常自动重启" IsOn="{Binding AutoRestartCollector, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </controls:NavigationView>
    </Grid>
</Window>
