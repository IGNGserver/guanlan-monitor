<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/device_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_online" />

        <TextView
            android:id="@+id/device_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="工作站"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/device_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_icon_button_bg"
            android:contentDescription="@string/widget_refresh"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/widget_ic_refresh" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/device_gauge_frame"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp">

        <ImageView
            android:id="@+id/device_gauge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_gauge_placeholder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/device_cpu_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:text="42"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/device_cpu_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="%"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/device_cpu_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="@string/widget_cpu"
                android:textColor="@color/widget_text_tertiary"
                android:textSize="8.5sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/widget_memory"
            android:textColor="@color/widget_text_secondary"
            android:textSize="8.5sp" />

        <ProgressBar
            android:id="@+id/device_memory_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="71"
            android:progressDrawable="@drawable/widget_progress" />

        <TextView
            android:id="@+id/device_memory_value"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:includeFontPadding="false"
            android:text="71%"
            android:textColor="@color/widget_text_primary"
            android:textSize="8.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/widget_disk"
            android:textColor="@color/widget_text_secondary"
            android:textSize="8.5sp" />

        <ProgressBar
            android:id="@+id/device_disk_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="54"
            android:progressDrawable="@drawable/widget_progress" />

        <TextView
            android:id="@+id/device_disk_value"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:includeFontPadding="false"
            android:text="54%"
            android:textColor="@color/widget_text_primary"
            android:textSize="8.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/device_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Windows 11"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="8.5sp" />

        <TextView
            android:id="@+id/device_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:text="20:42"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="8.5sp" />
    </LinearLayout>

</LinearLayout>
