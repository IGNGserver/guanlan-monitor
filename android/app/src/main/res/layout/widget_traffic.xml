<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="@string/widget_traffic_title"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/traffic_device"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="NAS"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="9sp" />

        <ImageButton
            android:id="@+id/traffic_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_icon_button_bg"
            android:contentDescription="@string/widget_refresh"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/widget_ic_refresh" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:baselineAligned="true"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/traffic_down_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="↓"
            android:textColor="@color/widget_accent"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/traffic_down_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:text="42.7"
            android:textColor="@color/widget_text_primary"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/traffic_down_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="GB"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/traffic_up"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="↑ 3.1 GB · 今日"
        android:textColor="@color/widget_text_secondary"
        android:textSize="9sp" />

    <ImageView
        android:id="@+id/traffic_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_weight="1"
        android:minHeight="20dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_chart_placeholder_bars" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/widget_month"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/traffic_month_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="1.24 TB"
            android:textColor="@color/widget_text_secondary"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/traffic_month_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="10 月"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="8sp" />
    </LinearLayout>

</LinearLayout>
