<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/device_dot"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_online" />

        <TextView
            android:id="@+id/device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="工作站"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/device_os"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Windows 11 · 6 小时"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/device_online_pill"
            android:layout_width="wrap_content"
            android:layout_height="23dp"
            android:background="@drawable/widget_pill_online"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/device_online_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_online" />

            <TextView
                android:id="@+id/device_online"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/widget_online"
                android:textColor="@color/widget_online"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/device_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_icon_button_bg"
            android:contentDescription="@string/widget_refresh"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/widget_ic_refresh" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <FrameLayout
            android:id="@+id/device_gauge_frame"
            android:layout_width="84dp"
            android:layout_height="84dp">

            <ImageView
                android:id="@+id/device_gauge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_gauge_placeholder" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/device_cpu_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:text="42"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/device_cpu_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:text="%"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/device_cpu_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:text="@string/widget_cpu"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="7.5sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/widget_cpu_six_hours"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/device_peak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:text="峰值 71%"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/device_spark"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:layout_marginTop="3dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_chart_placeholder" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/widget_memory"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9.5sp" />

                <ProgressBar
                    android:id="@+id/device_memory_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="71"
                    android:progressDrawable="@drawable/widget_progress" />

                <TextView
                    android:id="@+id/device_memory_value"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="71%"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/widget_disk"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9.5sp" />

                <ProgressBar
                    android:id="@+id/device_disk_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="54"
                    android:progressDrawable="@drawable/widget_progress" />

                <TextView
                    android:id="@+id/device_disk_value"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="54%"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/device_rx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:text="↓ 12.4 MB/s"
                    android:textColor="@color/widget_accent"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/device_tx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:text="↑ 1.8 MB/s"
                    android:textColor="@color/widget_violet"
                    android:textSize="9.5sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/widget_live_rate"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="7.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/device_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Windows 11 · 更新于 20:42"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="8.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/widget_change_device_hint"
            android:textColor="@color/widget_text_tertiary"
            android:textSize="8.5sp" />
    </LinearLayout>

</LinearLayout>
