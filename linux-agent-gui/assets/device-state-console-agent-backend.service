[Unit]
Description=Device State Console local agent backend
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/lib/device-state-console/device-state-console-agent-backend --bundle-root /usr/lib/device-state-console --config-root %h/.config/device-state-console --child-binary /usr/lib/device-state-console/device-state-console-agent
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
